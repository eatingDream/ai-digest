# Example only: publish.py regenerates this file (with the real slug) on every build.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; prefetch-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'
/<SITE_SLUG>/
  Cache-Control: public, max-age=60, stale-while-revalidate=604800
/<SITE_SLUG>/daily/*
  Cache-Control: public, max-age=300, stale-while-revalidate=604800
/<SITE_SLUG>/weekly/*
  Cache-Control: public, max-age=300, stale-while-revalidate=604800
