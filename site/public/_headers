# Example only: publish.py regenerates this file (with the real slug) on every build.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline'; script-src-attr 'none'; style-src 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; prefetch-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'; upgrade-insecure-requests
/favicon.svg
  Cache-Control: public, max-age=86400
/<SITE_SLUG>/
  Cache-Control: public, max-age=60, stale-while-revalidate=604800
/<SITE_SLUG>/daily/*
  Cache-Control: public, max-age=300, stale-while-revalidate=604800
/<SITE_SLUG>/weekly/*
  Cache-Control: public, max-age=300, stale-while-revalidate=604800
/<SITE_SLUG>/latest
  Cache-Control: no-store
/<SITE_SLUG>/latest/
  Cache-Control: no-store
/<SITE_SLUG>/daily/latest
  ! Cache-Control
  Cache-Control: no-store
/<SITE_SLUG>/daily/latest/
  ! Cache-Control
  Cache-Control: no-store
/<SITE_SLUG>/weekly/latest
  ! Cache-Control
  Cache-Control: no-store
/<SITE_SLUG>/weekly/latest/
  ! Cache-Control
  Cache-Control: no-store
