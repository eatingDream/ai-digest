# AI digest site config. No secrets here (password/salt/token live outside the repo).
# Copy to site/CONFIG, or set the env vars SITE_DOMAIN / SITE_SLUG / CF_ACCOUNT_ID / CF_ZONE_ID / CF_PAGES_PROJECT.
# `python3 publish.py --init` creates site/CONFIG with a random SLUG. Do not change SLUG once published.
PLATFORM=pages
PROJECT=ai-digest
ACCOUNT_ID=<CF_ACCOUNT_ID>
ZONE_ID=
DOMAIN=digest.example.com
SLUG=<random-unguessable-slug>
# Site language: en | zh-CN (env DIGEST_LANG or --lang overrides)
LANG=en
