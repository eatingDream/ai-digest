# AI digest site config. No secrets here (password/salt/token live outside the repo).
# Recommended: `ai-digest publish --init` creates site/CONFIG (public root-mounted, ENCRYPT=0).
# For an opt-in password-protected private site: `ai-digest publish --init --encrypt`
# (or set ENCRYPT=1 and a random >= 8 char SLUG).
# If copying this file (`cp site/CONFIG.example site/CONFIG`), replace every <...> placeholder
# before running `ai-digest publish` (leave ACCOUNT_ID empty when only running --prepare-only).
PLATFORM=pages
PROJECT=ai-digest
ACCOUNT_ID=<CF_ACCOUNT_ID>
ZONE_ID=
DOMAIN=digest.example.com
# Optional URL path prefix (leave empty for root-mounted /zh/, /en/, /latest; >= 8 chars if set)
SLUG=
# Client-side password encryption: 0 (default, public) | 1 (opt-in AES-256-GCM password prompt)
ENCRYPT=0
# Site language: en | zh-CN (env DIGEST_LANG or --lang overrides; zh-CN with *.en.md auto-emits /zh/ and /en/)
LANG=en
# Optional companion site in the other language (e.g. zh-CN:/zh-CN/ or https://zh.digest.example.com/<slug>/)
LANG_ALT=
# Optional when SLUG is set: expose root-level /latest, /zh/latest, /en/latest static pages (HTTP 200)
# ROOT_LATEST=0
# Optional IndexNow key (8-128 ASCII alphanumeric/hyphen chars) to emit /<key>.txt and push canonical URLs after public deploys
# INDEXNOW_KEY=
